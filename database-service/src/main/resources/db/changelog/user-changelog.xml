<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="thani">
        <createTable tableName="user">
            <column name="uuid" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="id" type="bigint" autoIncrement="true">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="varchar(255)">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="6" author="thani">
        <renameTable oldTableName="users" newTableName="user"/>
    </changeSet>

    <changeSet id="7-update-user-uuid" author="thani">
        <!-- Generate UUIDs for any user records where uuid is NULL or empty -->
        <sql>
            UPDATE user SET uuid = UUID() WHERE uuid IS NULL OR uuid = '';
        </sql>

        <!-- Make uuid column NOT NULL -->
        <addNotNullConstraint tableName="user" columnName="uuid" columnDataType="varchar(36)"/>
    </changeSet>

    <changeSet id="08-modify-uuid-columns-to-varchar" author="thani">
        <modifyDataType tableName="user" columnName="uuid" newDataType="varchar(36)"/>
    </changeSet>

    <changeSet id="17" author="thani">
        <addColumn tableName="user">
            <column name="salesforce_sync_status" type="varchar(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="salesforce_retry_count" type="int" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="20-drop-password-column-from-user" author="thani">
        <preConditions onFail="CONTINUE">
            <columnExists tableName="user" columnName="password"/>
        </preConditions>
        <dropColumn tableName="user" columnName="password"/>
    </changeSet>

    <changeSet id="21-add-phone-column-to-user" author="thani">
        <addColumn tableName="user">
            <column name="phone" type="varchar(30)"/>
        </addColumn>
    </changeSet>

    <changeSet id="22-add-account-inactivity-columns-to-user" author="thani">
        <addColumn tableName="user">
            <column name="status" type="varchar(20)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="last_login_at" type="timestamp"/>
            <column name="inactivity_warning_sent_at" type="timestamp"/>
            <column name="deactivated_at" type="timestamp"/>
            <column name="reactivation_requested" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="reactivation_requested_at" type="timestamp"/>
        </addColumn>
    </changeSet>

    <changeSet id="23-migrate-null-last-login-at" author="thani">
        <sql>
            UPDATE user SET last_login_at = COALESCE(created_at, NOW()) WHERE last_login_at IS NULL;
        </sql>
    </changeSet>

    <changeSet id="24-align-account-inactivity-and-reactivation-columns" author="thani">
        <addColumn tableName="user">
            <column name="reactivation_request_status" type="varchar(20)"/>
        </addColumn>
        <sql>
            UPDATE user SET reactivation_request_status = 'PENDING' WHERE reactivation_requested = 1;
        </sql>
        <dropColumn tableName="user" columnName="reactivation_requested"/>
        <dropColumn tableName="user" columnName="reactivation_requested_at"/>
        <dropColumn tableName="user" columnName="deactivated_at"/>
    </changeSet>

    <changeSet id="25-add-deactivated-at-column-to-user" author="thani">
        <addColumn tableName="user">
            <column name="deactivated_at" type="timestamp"/>
        </addColumn>
        <sql>
            UPDATE user SET deactivated_at = COALESCE(updated_at) WHERE status = 'DEACTIVATED' AND deactivated_at IS NULL;
        </sql>
    </changeSet>

    <changeSet id="26-enlarge-status-column-and-expire-accounts" author="thani">
        <modifyDataType tableName="user" columnName="status" newDataType="varchar(30)"/>
        <sql>
            UPDATE user 
            SET deactivated_at = DATE_ADD(COALESCE(last_login_at, created_at), INTERVAL 30 DAY)
            WHERE status = 'DEACTIVATED'
              AND last_login_at IS NOT NULL
              AND DATE_ADD(last_login_at, INTERVAL 30 DAY) &lt; deactivated_at;

            UPDATE user
            SET status = 'PERMANENTLY_DEACTIVATED', reactivation_request_status = NULL
            WHERE status = 'DEACTIVATED'
              AND deactivated_at &lt;= DATE_SUB(NOW(), INTERVAL 10 DAY);
        </sql>
    </changeSet>

    <changeSet id="27-add-aadhaar-columns-to-user" author="thani">
        <addColumn tableName="user">
            <column name="aadhaar_last4" type="varchar(4)"/>
            <column name="aadhaar_hash" type="varchar(64)"/>
        </addColumn>
        <addUniqueConstraint tableName="user" columnNames="aadhaar_hash" constraintName="uk_user_aadhaar_hash"/>
    </changeSet>

</databaseChangeLog>
