<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="initialize-reward-points" author="thaniyarasi">

        <sql>
            INSERT INTO library.reward
                (uuid, user_uuid, points, created_at, updated_at)
            SELECT
                UUID(),
                u.uuid,
                0,
                NOW(),
                NOW()
            FROM library.user u
            WHERE NOT EXISTS (
                SELECT 1
                FROM library.reward r
                WHERE r.user_uuid = u.uuid
            );
        </sql>

    </changeSet>

</databaseChangeLog>