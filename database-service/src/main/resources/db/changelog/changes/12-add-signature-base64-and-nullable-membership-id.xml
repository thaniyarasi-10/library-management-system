<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="12" author="thani">
        <addColumn tableName="membership">
            <column name="signature_base64" type="longtext">
                <constraints nullable="true"/>
            </column>
            <column name="cancelled_at" type="timestamp">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <dropNotNullConstraint tableName="membership" columnName="membership_id" columnDataType="bigint"/>
    </changeSet>

</databaseChangeLog>
